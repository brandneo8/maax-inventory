# Copy this file to .env.local and fill in values from the Supabase dashboard.
# Project Settings → API
#
# NEXT_PUBLIC_ values are safe to expose in the browser.
# SUPABASE_SERVICE_ROLE_KEY is server-only. Never put it in client code.

SUPABASE_PROJECT_ID=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only: secret (service role) key. Used later for admin/server jobs.
SUPABASE_SERVICE_ROLE_KEY=""
